{
  "name": "stlstr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A pnpm monorepo: the stlstr Vite host app and a collection of NIP-5D napplets.",
  "scripts": {
    "new": "node scripts/new-napplet.mjs",
    "dev": "node scripts/dev.mjs",
    "prepare": "pnpm build",
    "build": "turbo run build --filter=...{./napplets/*}",
    "build:app": "turbo run build --filter=@apps/stlstr",
    "verify": "pnpm test && turbo run type-check build --filter={./napplets/*} --filter={./lib/*}",
    "test": "pnpm test:adopt && turbo run test --filter={./napplets/*} --filter={./lib/*}",
    "test:adopt": "node --test scripts/lib/adopt.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "type-check": "turbo run type-check --filter={./napplets/*} --filter={./lib/*}",
    "discover": "napplet discover --all",
    "test:conformance": "pnpm build && napplet conformance --all",
    "login": "napplet keys store --name stlstr --prompt-sec && napplet keys use --name stlstr",
    "logout": "napplet keys delete --name stlstr",
    "keys": "napplet keys",
    "deploy": "pnpm build && napplet deploy --all",
    "deploy:dry": "pnpm build && napplet deploy --all --dry-run",
    "deploy:dev": "pnpm build && napplet deploy --all --config .napplet/config.dev.json",
    "deploy:dev:dry": "pnpm build && napplet deploy --all --dry-run --config .napplet/config.dev.json",
    "debug": "napplet debug --all",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "@kehto/cli": "^0.2.16",
    "@napplelets/napplet-cli": "workspace:*",
    "@napplet/conformance-cli": "^0.2.15",
    "nostr-tools": "^2.24.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "puppeteer": "^24.31.0",
    "turbo": "^2.10.5",
    "ws": "^8.21.1"
  },
  "license": "MIT"
}
