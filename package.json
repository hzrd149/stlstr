{
  "name": "stlstr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A pnpm monorepo: the stlstr Vite host app and a collection of NIP-5D napplets.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare": "pnpm napplet:build",
    "verify": "pnpm test && VITE_DEV_PRIVKEY_HEX=${VITE_DEV_PRIVKEY_HEX:-00000000000000000000000000000000000000000000000000000000deadbeef} turbo run type-check build --filter={./napplets/*} --filter={./lib/*}",
    "test": "pnpm test:scripts && turbo run test --filter={./napplets/*} --filter={./lib/*}",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "type-check": "turbo run type-check --filter={./napplets/*} --filter={./lib/*}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app:build": "pnpm napplet:build && turbo run build --filter=@apps/stlstr",
    "app:deploy": "pnpm app:build && nsyte deploy apps/stlstr/dist",
    "app:deploy:dry": "pnpm app:build && nsyte deploy apps/stlstr/dist --dry-run",
    "napplet:new": "node scripts/new-napplet.mjs",
    "napplet:build": "VITE_DEV_PRIVKEY_HEX=${VITE_DEV_PRIVKEY_HEX:-00000000000000000000000000000000000000000000000000000000deadbeef} turbo run build --filter=...{./napplets/*}",
    "napplet:discover": "napplet discover --all",
    "napplet:conformance": "pnpm napplet:build && napplet conformance --all",
    "napplet:debug": "napplet debug --all",
    "napplet:deploy": "pnpm napplet:build && napplet deploy --all --config .napplet/config.json",
    "napplet:deploy:dry": "pnpm napplet:build && napplet deploy --all --dry-run --config .napplet/config.json",
    "napplet:login": "napplet keys store --name hzrd149 --prompt-sec && napplet keys use --name hzrd149 --config .napplet/config.json",
    "napplet:logout": "napplet keys delete --name hzrd149",
    "napplet:keys": "napplet keys"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "@kehto/cli": "^0.2.16",
    "@napplelets/napplet-cli": "workspace:*",
    "@napplet/conformance-cli": "^0.2.15",
    "nostr-tools": "^2.24.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "puppeteer": "^24.31.0",
    "turbo": "^2.10.5",
    "ws": "^8.21.1"
  },
  "license": "MIT"
}
