{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["scripts/lib/napplet-metadata.ts", "scripts/lib/napplet-icon.png"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_DEV_PRIVKEY_HEX"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
